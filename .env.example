# ═══════════════════════════════════════════════════════════════════
# مشوار: متغيرات الإعداد
# التطبيق ما بيقرا هالملف مباشرة: القيم بتنمرق وقت البناء بـ --dart-define،
# وبـ GitHub Actions بتنحط كأسرار (Settings › Secrets and variables › Actions).
# لا تحط أي قيمة حقيقية بهالملف ولا ترفعو مع أسرار.
# ═══════════════════════════════════════════════════════════════════

# ── التطبيق والصفحات (قيم عامة، الحماية من RLS) ─────────────────────
# Supabase › Project settings › API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# صفحة متابعة الأهل (اختياري، الافتراضي GitHub Pages)
TRACK_BASE_URL=https://ahmadtaim450-lang.github.io/mishwar/track/

# رقم الدعم (اختياري)
SUPPORT_PHONE=

# Firebase › Project settings › General › تطبيق أندرويد (إعدادات عامة مو أسرار)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# ── النشر التلقائي لقاعدة البيانات (أسرار) ──────────────────────────
# Supabase › Account › Access tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ── أسرار دوال السيرفر: شوف supabase/functions/.env.example ─────────
# PUSH_SECRET, FCM_SERVICE_ACCOUNT, ADMIN_ORIGINS

# ── مزوّد SMS: بينحط بلوحة Supabase › Authentication › Providers › Phone
# (مثلاً Twilio: Account SID, Auth Token, Message Service SID)

# مثال تشغيل محلي:
# flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
