# أسرار دوال Supabase (Edge Functions). بالإنتاج: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL و SUPABASE_ANON_KEY و SUPABASE_SERVICE_ROLE_KEY بيتعبّوا لحالن.

# كلمة سر طويلة عشوائية، ونفس القيمة بتنحط بالـ Vault باسم push_secret
PUSH_SECRET=

# ملف حساب الخدمة من Firebase (Project settings › Service accounts) كـ JSON بسطر واحد
FCM_SERVICE_ACCOUNT=

# مواقع لوحة الإدارة المسموحة (مفصولة بفواصل)
ADMIN_ORIGINS=https://ahmadtaim450-lang.github.io

# ── الخرائط (دالة geo) ──
# المزود: ors (OpenRouteService، بدو مفتاح، فيه باقة مجانية) أو osm (بلا مفتاح، للتجربة بس)
# إذا ORS_API_KEY موجود وما حددت GEO_PROVIDER، بينختار ors لحالو.
GEO_PROVIDER=
ORS_API_KEY=
# إيميل أو رابط للتواصل (إجباري بسياسة Nominatim/OSRM لما المزود osm)
GEO_CONTACT=
# حد الطلبات اللي بتروح للمزود لكل مستخدم بالساعة (الكاش ما بينحسب)
GEO_HOURLY_LIMIT=100
